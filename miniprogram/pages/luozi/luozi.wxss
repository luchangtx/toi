/* pages/luozi/luozi.wxss */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background:
    radial-gradient(circle at 20% 0%, rgba(129, 140, 248, 0.08) 0%, transparent 45%),
    radial-gradient(circle at 90% 100%, rgba(255, 215, 0, 0.05) 0%, transparent 40%),
    var(--bg-base);
}

/* ---------- HUD ---------- */
.hud {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 36rpx 6rpx;
}
.hud-col { display: flex; flex-direction: column; }
.hud-right { align-items: flex-end; }
.hud-label {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--text-dim);
  margin-bottom: 4rpx;
}
.hud-target {
  font-size: 68rpx;
  line-height: 1.05;
  font-weight: 700;
  color: var(--text-strong);
  text-shadow: 0 0 24rpx rgba(255, 215, 0, 0.35);
}
.hud-moves {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-strong);
  line-height: 1.15;
}
.hud-par {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-dim);
}

/* ---------- 棋盘 ---------- */
.board-wrap {
  flex: 1;
  min-height: 0;
  padding: 4rpx 24rpx;
}
.board { width: 100%; height: 100%; }

.hint-bar {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-dim);
  min-height: 36rpx;
  padding: 0 40rpx 10rpx;
}

/* ---------- 控制区 ---------- */
.controls {
  padding: 0 32rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.ctrl-row { display: flex; gap: 16rpx; }
.ctrl-row.minor { justify-content: center; }

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: var(--bg-elev);
  border: 2rpx solid var(--border-mid);
  color: var(--text-main);
  transition: transform 0.06s ease;
}
.btn.small {
  padding: 12rpx 40rpx;
  font-size: 26rpx;
  color: var(--text-dim);
}
.btn.big {
  flex: 1;
  height: 104rpx;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.btn.accent {
  border-color: rgba(129, 140, 248, 0.55);
  color: #c7d2fe;
  background: rgba(129, 140, 248, 0.10);
}
.btn-hover { transform: scale(0.97); background: rgba(255, 255, 255, 0.08); }

/* ---------- 弹层 ---------- */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(3, 5, 10, 0.72);
  backdrop-filter: blur(6px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}
.win-card {
  width: 560rpx;
  padding: 48rpx 40rpx 40rpx;
  border-radius: 32rpx;
  background: #0c101c;
  border: 2rpx solid var(--border-mid);
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.win-char {
  font-size: 120rpx;
  font-weight: 700;
  color: var(--c-gold);
  text-shadow: 0 0 40rpx rgba(255, 215, 0, 0.5);
  line-height: 1.1;
}
.win-stars { margin: 18rpx 0 8rpx; }
.star {
  font-size: 64rpx;
  margin: 0 10rpx;
  color: rgba(255, 255, 255, 0.12);
}
.star.on { color: var(--c-gold); text-shadow: 0 0 18rpx rgba(255, 215, 0, 0.6); }
.win-desc { font-size: 26rpx; color: var(--text-dim); margin-bottom: 30rpx; }
.win-btns { display: flex; gap: 20rpx; }
.win-btns .btn.small { padding: 16rpx 48rpx; font-size: 28rpx; color: var(--text-main); }
.win-all { margin-top: 24rpx; font-size: 26rpx; color: var(--c-gold); }

/* ---------- 选关 ---------- */
.picker {
  width: 640rpx;
  max-height: 78vh;
  overflow-y: auto;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 32rpx;
  background: #0c101c;
  border: 2rpx solid var(--border-mid);
}
.picker-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-strong);
  letter-spacing: 4rpx;
  text-align: center;
  margin-bottom: 24rpx;
}
.picker-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}
.cell {
  border-radius: 18rpx;
  border: 2rpx solid var(--border-soft);
  background: var(--bg-elev);
  padding: 14rpx 0 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.cell.current { border-color: rgba(129, 140, 248, 0.7); }
.cell.locked { opacity: 0.38; }
.cell-char { font-size: 44rpx; color: var(--text-strong); line-height: 1.15; }
.cell.locked .cell-char { font-size: 32rpx; }
.cell-stars { display: flex; gap: 2rpx; }
.mini { font-size: 18rpx; color: rgba(255, 255, 255, 0.12); }
.mini.on { color: var(--c-gold); }
.picker-close {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-faint);
}

/* ---------- 体感卡片 ---------- */
.tilt-card {
  flex: 1;
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 28rpx;
  border-radius: 22rpx;
  border: 2rpx dashed rgba(129, 140, 248, 0.35);
  background: rgba(129, 140, 248, 0.06);
}
.tilt-status {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.4;
  color: var(--text-dim);
}
.tilt-btns { display: flex; gap: 12rpx; }
.tilt-btn {
  font-size: 22rpx;
  color: var(--text-dim);
  padding: 10rpx 22rpx;
  border-radius: 14rpx;
  border: 2rpx solid var(--border-soft);
  background: var(--bg-elev);
  white-space: nowrap;
}

/* ---------- 无尽模式 ---------- */
.ctrl-row { flex-wrap: wrap; justify-content: center; }
.win-endless { margin-top: 24rpx; padding: 16rpx 48rpx; font-size: 28rpx; }
