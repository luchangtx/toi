<view class="page">
  <!-- HUD -->
  <view class="hud">
    <view class="hud-col">
      <view class="hud-label">{{endless ? '无尽 · 已通 ' + endlessCleared + ' 关' : '第 ' + (levelIndex + 1) + ' / ' + total + ' 关'}}</view>
      <view class="hud-target">{{targetChar}}</view>
    </view>
    <view class="hud-col hud-right">
      <view class="hud-label">步数</view>
      <view class="hud-moves">{{moves}}<text class="hud-par"> / 最优 {{par}}</text></view>
    </view>
  </view>

  <!-- 棋盘 -->
  <view class="board-wrap">
    <canvas type="2d" id="board" class="board"></canvas>
  </view>

  <view class="hint-bar">{{hint}}</view>

  <!-- 控制区 -->
  <view class="controls">
    <view class="ctrl-row minor">
      <view class="btn small" hover-class="btn-hover" bindtap="resetLevel">↺ 重开</view>
      <view class="btn small" hover-class="btn-hover" bindtap="hintMove">？提示</view>
      <view class="btn small" wx:if="{{endless}}" hover-class="btn-hover" bindtap="rerollEndless">⇄ 换一个</view>
      <view class="btn small" hover-class="btn-hover" bindtap="openPicker">☰ 选关</view>
      <view class="btn small" hover-class="btn-hover" bindtap="toggleMode">{{mode === 'tilt' ? '按钮模式' : '体感模式'}}</view>
      <view class="btn small" hover-class="btn-hover" bindtap="toggleEndless">{{endless ? '回战役' : '∞ 无尽'}}</view>
    </view>
    <view class="ctrl-row" wx:if="{{mode === 'tilt'}}">
      <view class="tilt-card">
        <view class="tilt-status">{{tiltStatus}}</view>
        <view class="tilt-btns">
          <view class="tilt-btn" hover-class="btn-hover" bindtap="recalibrate">校准</view>
          <view class="tilt-btn" hover-class="btn-hover" bindtap="flipMirror">方向反了</view>
        </view>
      </view>
    </view>
    <view class="ctrl-row" wx:else>
      <view class="btn big" hover-class="btn-hover" bindtap="rotateCCW">⟲ 逆时针</view>
      <view class="btn big accent" hover-class="btn-hover" bindtap="rotateCW">⟳ 顺时针</view>
    </view>
  </view>

  <!-- 结算 -->
  <view class="overlay" wx:if="{{won}}">
    <view class="win-card">
      <view class="win-char">{{targetChar}}</view>
      <view class="win-stars">
        <text class="star {{stars >= 1 ? 'on' : ''}}">★</text>
        <text class="star {{stars >= 2 ? 'on' : ''}}">★</text>
        <text class="star {{stars >= 3 ? 'on' : ''}}">★</text>
      </view>
      <view class="win-desc">用了 {{moves}} 步 · 最优 {{par}} 步</view>
      <view class="win-btns">
        <view class="btn small" hover-class="btn-hover" bindtap="resetLevel">再玩一次</view>
        <view class="btn small accent" hover-class="btn-hover" wx:if="{{endless || !allCleared}}" bindtap="nextLevel">下一关 →</view>
      </view>
      <view class="win-all" wx:if="{{!endless && allCleared}}">全部通关，恭喜出师！</view>
      <view class="btn small accent win-endless" wx:if="{{!endless && allCleared}}" hover-class="btn-hover" bindtap="enterEndless">∞ 进入无尽模式</view>
    </view>
  </view>

  <!-- 选关 -->
  <view class="overlay" wx:if="{{pickerOpen}}" bindtap="closePicker">
    <view class="picker" catchtap="noop">
      <view class="picker-title">选关</view>
      <view class="picker-grid">
        <view
          wx:for="{{pickerLevels}}"
          wx:key="idx"
          class="cell {{item.locked ? 'locked' : ''}} {{item.current ? 'current' : ''}}"
          data-idx="{{item.idx}}"
          bindtap="pickLevel"
        >
          <view class="cell-char">{{item.locked ? '🔒' : item.char}}</view>
          <view class="cell-stars">
            <text class="mini {{item.stars >= 1 ? 'on' : ''}}">★</text>
            <text class="mini {{item.stars >= 2 ? 'on' : ''}}">★</text>
            <text class="mini {{item.stars >= 3 ? 'on' : ''}}">★</text>
          </view>
        </view>
      </view>
      <view class="picker-close">轻点空白处关闭</view>
    </view>
  </view>
</view>
