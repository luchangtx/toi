/* ============================================
   冰球比赛计时与统计系统（1:1 移植自 711.html）
   设计基准 375px，1px → 2rpx
   ============================================ */

.toi-page {
  --bg-root: #070b14;
  --bg-surface: #0d1424;
  --bg-elevated: #141e34;
  --border-subtle: rgba(56, 189, 248, 0.07);
  --border-default: rgba(56, 189, 248, 0.14);
  --border-active: rgba(34, 211, 238, 0.45);
  --border-selected: rgba(34, 211, 238, 0.65);
  --accent-ice: #22d3ee;
  --accent-ice-dim: #0891b2;
  --accent-red: #f43f5e;
  --accent-green: #10b981;
  --accent-amber: #f59e0b;
  --text-primary: #e2e8f0;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;
  --warning-color: #f59e0b;
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 20rpx;
  --shadow-sm: 0 2rpx 4rpx rgba(0, 0, 0, 0.4);
  --shadow-md: 0 8rpx 40rpx rgba(0, 0, 0, 0.5);
  --shadow-lg: 0 16rpx 80rpx rgba(0, 0, 0, 0.6);
  --shadow-glow: 0 0 40rpx rgba(34, 211, 238, 0.15);
  /* backdrop-filter 不支持 → 提高不透明度替代毛玻璃 */
  --glass-bg-controls: rgba(13, 20, 36, 0.96);
  --glass-bg-card: rgba(15, 22, 36, 0.7);
  --glass-bg: rgba(255, 255, 255, 0.04);
  --glass-bg-input: rgba(0, 0, 0, 0.2);
  --glass-row-hover: rgba(255, 255, 255, 0.02);
  --th-bg: rgba(14, 165, 233, 0.08);
  --timer-bg: rgba(34, 211, 238, 0.06);
  --timer-border: rgba(34, 211, 238, 0.2);
  --timer-glow: 0 0 24rpx rgba(34, 211, 238, 0.3);
  --danger-border: rgba(244, 63, 94, 0.4);
  --danger-bg-hover: rgba(244, 63, 94, 0.1);
  --amber-border: rgba(245, 158, 11, 0.35);
  --amber-bg-hover: rgba(245, 158, 11, 0.1);
  --selected-bg: rgba(14, 165, 233, 0.08);
  --selected-number-glow: 0 0 32rpx rgba(34, 211, 238, 0.4);
  --role-bg: rgba(255, 255, 255, 0.06);
  --edit-btn-bg: rgba(255, 255, 255, 0.06);
  --score-shadow: 0 4rpx 16rpx rgba(244, 63, 94, 0.4);
  --modal-backdrop: rgba(0, 0, 0, 0.65);
  --toast-shadow: 0 8rpx 32rpx rgba(16, 185, 129, 0.4);
  --watermark-color: rgba(255, 255, 255, 0.02);

  min-height: 100vh;
  padding: 24rpx 16rpx 48rpx;
  background: var(--bg-root);
  color: var(--text-primary);
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 1;
  font-size: 26rpx;
}

/* ── 浅色主题（原版 body.light） ── */
.toi-page.light {
  --bg-root: #f1f5f9;
  --bg-surface: #ffffff;
  --bg-elevated: #f8fafc;
  --border-subtle: rgba(14, 165, 233, 0.1);
  --border-default: rgba(14, 165, 233, 0.2);
  --border-active: rgba(8, 145, 178, 0.5);
  --border-selected: rgba(8, 145, 178, 0.7);
  --accent-ice: #0891b2;
  --accent-ice-dim: #0e7490;
  --accent-red: #e11d48;
  --accent-green: #059669;
  --accent-amber: #d97706;
  --text-primary: #1e293b;
  --text-secondary: #475569;
  --text-muted: #94a3b8;
  --warning-color: #d97706;
  --shadow-sm: 0 2rpx 4rpx rgba(0, 0, 0, 0.06);
  --shadow-md: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 16rpx 64rpx rgba(0, 0, 0, 0.12);
  --shadow-glow: 0 0 40rpx rgba(8, 145, 178, 0.12);
  --glass-bg-controls: rgba(255, 255, 255, 0.96);
  --glass-bg-card: rgba(255, 255, 255, 0.85);
  --glass-bg: rgba(0, 0, 0, 0.04);
  --glass-bg-input: rgba(0, 0, 0, 0.04);
  --glass-row-hover: rgba(0, 0, 0, 0.02);
  --th-bg: rgba(8, 145, 178, 0.06);
  --timer-bg: rgba(8, 145, 178, 0.06);
  --timer-border: rgba(8, 145, 178, 0.2);
  --timer-glow: none;
  --danger-border: rgba(225, 29, 72, 0.4);
  --danger-bg-hover: rgba(225, 29, 72, 0.08);
  --amber-border: rgba(217, 119, 6, 0.3);
  --amber-bg-hover: rgba(217, 119, 6, 0.08);
  --selected-bg: rgba(8, 145, 178, 0.08);
  --selected-number-glow: none;
  --role-bg: rgba(0, 0, 0, 0.05);
  --edit-btn-bg: rgba(0, 0, 0, 0.05);
  --score-shadow: 0 4rpx 16rpx rgba(225, 29, 72, 0.3);
  --modal-backdrop: rgba(0, 0, 0, 0.4);
  --toast-shadow: 0 8rpx 32rpx rgba(5, 150, 105, 0.3);
  --watermark-color: rgba(0, 0, 0, 0.02);
}

/* ── 控制栏 ── */
.controls {
  position: sticky;
  top: 12rpx;
  z-index: 100;
  width: 100%;
  background: var(--glass-bg-controls);
  border: 2rpx solid var(--border-default);
  padding: 20rpx 24rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.global-timer {
  font-size: 48rpx;
  padding: 12rpx 24rpx;
  margin: 0 8rpx;
  font-weight: 700;
  color: var(--accent-ice);
  background: var(--timer-bg);
  border: 2rpx solid var(--timer-border);
  border-radius: var(--radius-md);
  font-family: 'Courier New', monospace;
  letter-spacing: 4rpx;
  min-width: 180rpx;
  text-align: center;
  text-shadow: var(--timer-glow);
}

.btn {
  padding: 14rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
  border: 2rpx solid transparent;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  white-space: nowrap;
}

.btn:active {
  transform: scale(0.97);
}

.btn.success {
  background: var(--accent-green);
  color: #fff;
  border-color: var(--accent-green);
}

.btn.danger {
  background: transparent;
  color: var(--accent-red);
  border-color: var(--danger-border);
}
.btn.danger:active {
  background: var(--danger-bg-hover);
  border-color: var(--accent-red);
}

.btn.accent {
  background: transparent;
  color: var(--accent-amber);
  border-color: var(--amber-border);
}
.btn.accent:active {
  background: var(--amber-bg-hover);
  border-color: var(--accent-amber);
}

.btn.secondary {
  background: var(--glass-bg);
  color: var(--text-secondary);
  border-color: var(--border-subtle);
}

.disabled {
  opacity: 0.3;
  transform: none !important;
  box-shadow: none !important;
}

.fast-controls {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 0 12rpx;
}

/* ── 队员卡片 ── */
.container {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  width: 100%;
  margin-top: 28rpx;
  gap: 16rpx;
}

.card {
  position: relative;
  width: 226rpx;
  min-height: 252rpx;
  padding: 16rpx;
  background: var(--glass-bg-card);
  border: 2rpx solid var(--border-subtle);
  border-radius: var(--radius-md);
  text-align: center;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
}

.card:active {
  border-color: var(--border-default);
}

.card.selected {
  border-color: var(--border-selected);
  background: var(--selected-bg);
  box-shadow: var(--shadow-glow), var(--shadow-md);
}

.number {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin: 24rpx 0 8rpx;
  letter-spacing: -2rpx;
  line-height: 1;
}

.card.selected .number {
  color: var(--accent-ice);
  text-shadow: var(--selected-number-glow);
}

.role {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: var(--role-bg);
  color: var(--text-secondary);
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 28rpx;
  border: 2rpx solid var(--border-subtle);
}

.card.selected .role {
  border-color: var(--border-active);
  color: var(--text-primary);
}

/* 原版 MutationObserver：位置为 G 时高亮门将 */
.role.role-g {
  background: var(--warning-color);
  color: #000;
}

.timer {
  font-weight: 700;
  color: var(--text-secondary);
  font-size: 32rpx;
  margin: 12rpx 0 8rpx;
  font-family: 'Courier New', monospace;
  letter-spacing: 2rpx;
}

.card.selected .timer {
  color: var(--accent-ice);
}

/* 原版靠 :hover 显出，移动端无 hover → 常驻显示 */
.edit-button {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 52rpx;
  height: 52rpx;
  background: var(--edit-btn-bg);
  border: 2rpx solid var(--border-subtle);
  border-radius: 8rpx;
  font-size: 28rpx;
  color: var(--text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.edit-button:active {
  color: var(--accent-ice);
  border-color: var(--border-active);
}

.score {
  position: absolute;
  bottom: 12rpx;
  right: 12rpx;
  background: var(--accent-red);
  color: #fff;
  min-width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 26rpx;
  padding: 0 12rpx;
  box-shadow: var(--score-shadow);
}

/* ── 结果区 ── */
.results-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  gap: 40rpx;
  margin-top: 48rpx;
}

.section-title {
  color: var(--text-secondary);
  margin-bottom: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.accent-title {
  color: var(--accent-ice);
  font-size: 28rpx;
}

.goals-display {
  width: 100%;
  padding: 32rpx;
  background: var(--bg-surface);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  border: 2rpx solid var(--border-subtle);
}

.goal-entry {
  margin: 16rpx 0;
  padding: 24rpx 28rpx;
  background: var(--glass-row-hover);
  border-radius: var(--radius-sm);
  border-left: 6rpx solid var(--border-default);
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 1.5;
}

.goal-strong {
  color: var(--accent-red);
  font-weight: 600;
}

.table-scroll {
  width: 100%;
}

.results-table {
  width: 100%;
  background: var(--bg-surface);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 2rpx solid var(--border-subtle);
}

.tr {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid var(--border-subtle);
}

.tr:last-child {
  border-bottom: none;
}

.th,
.td {
  flex: 1;
  padding: 22rpx 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-primary);
}

.th {
  background: var(--th-bg);
  color: var(--accent-ice);
  font-weight: 600;
  font-size: 24rpx;
  letter-spacing: 0.04em;
}

.th.wide,
.td.wide {
  flex: 1.6;
}

/* ── 操作说明 ── */
.shortcut-info {
  background: var(--bg-surface);
  padding: 32rpx 36rpx;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  border: 2rpx solid var(--border-subtle);
  margin-top: 48rpx;
  width: 100%;
}

.shortcut-grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.shortcut-item {
  padding: 14rpx 20rpx;
  background: var(--glass-row-hover);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.shortcut-key {
  display: inline-block;
  background: var(--glass-bg);
  border: 2rpx solid var(--border-subtle);
  border-radius: 6rpx;
  padding: 2rpx 14rpx;
  margin: 0 8rpx;
  font-family: 'Courier New', monospace;
  font-size: 22rpx;
  color: var(--text-primary);
}

/* ── 弹窗 ── */
.modal {
  position: fixed;
  z-index: 1000;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: var(--modal-backdrop);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  position: relative;
  background: var(--bg-elevated);
  padding: 48rpx 44rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
  border: 2rpx solid var(--border-default);
  width: 90%;
  max-width: 660rpx;
  max-height: 84vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  color: var(--text-muted);
  font-size: 44rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  line-height: 1;
}

.close:active {
  color: var(--accent-red);
}

.center {
  text-align: center;
  width: 100%;
  margin: 24rpx 0;
}

.modal-title {
  font-weight: 700;
  font-size: 36rpx;
  color: var(--text-primary);
}

.modal-btn {
  display: inline-block;
  padding: 20rpx 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: var(--radius-sm);
  background: var(--accent-ice-dim);
  color: #fff;
  letter-spacing: 0.02em;
}

.modal-btn:active {
  background: var(--accent-ice);
}

.form-table {
  border: 2rpx solid var(--border-subtle);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.form-row {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid var(--border-subtle);
}

.form-row:last-child {
  border-bottom: none;
}

.form-row.inline {
  border: none;
  gap: 12rpx;
  justify-content: center;
}

.form-label {
  flex: 1;
  padding: 22rpx 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-primary);
}

.form-row.inline .form-label {
  flex: none;
}

.form-field {
  flex: 1;
  padding: 12rpx 16rpx;
}

.ipt {
  height: 72rpx;
  padding: 12rpx 24rpx;
  border: 2rpx solid var(--border-default);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  background: var(--glass-bg-input);
  color: var(--text-primary);
  width: 100%;
}

.ipt.picker {
  display: flex;
  align-items: center;
  justify-content: center;
}

.ipt.short {
  width: 150rpx;
}

.cell-ipt {
  height: 64rpx;
  font-size: 26rpx;
  padding: 8rpx 12rpx;
  text-align: center;
}

.batch-scroll {
  max-height: 52vh;
  width: 100%;
  margin: 16rpx 0;
}

.score-context {
  display: flex;
  justify-content: center;
}

/* ── Toast（原版 #tipModal） ── */
.tip-modal {
  position: fixed;
  z-index: 1001;
  left: 50%;
  top: 32rpx;
  transform: translateX(-50%);
  background: var(--accent-green);
  padding: 24rpx 64rpx;
  color: #fff;
  border-radius: 40rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
  opacity: 0;
  box-shadow: var(--toast-shadow);
  pointer-events: none;
  transition: opacity 0.4s, top 0.4s;
}

.tip-modal.show {
  opacity: 1;
  top: 56rpx;
}

/* ── 水印 ── */
.watermark {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(-15deg);
  color: var(--watermark-color);
  z-index: 100000;
  pointer-events: none;
  font-size: 200rpx;
  font-weight: 800;
  white-space: nowrap;
  letter-spacing: 16rpx;
}
