<view class="toi-page {{theme === 'light' ? 'light' : ''}}">

  <!-- ── 水印（原版 setWatermark 插入 body 的 .watermark div） ── -->
  <view class="watermark" wx:if="{{watermark}}">{{watermark}}</view>

  <!-- ── 控制栏 ── -->
  <view class="controls">
    <view class="global-timer">{{globalText}}</view>

    <view class="fast-controls">
      <view class="btn secondary {{isRunning ? '' : 'disabled'}}"
            bindtouchstart="onRewindStart" bindtouchend="onFastEnd" bindtouchcancel="onFastEnd">
        <text>⏮</text><text>快退</text>
      </view>
      <view class="btn secondary {{isRunning ? '' : 'disabled'}}"
            bindtouchstart="onForwardStart" bindtouchend="onFastEnd" bindtouchcancel="onFastEnd">
        <text>快进</text><text>⏭</text>
      </view>
    </view>

    <view class="btn success {{isRunning ? 'disabled' : ''}}" bindtap="onStart">
      <text>▶</text><text>开始</text>
    </view>
    <view class="btn secondary {{isRunning ? '' : 'disabled'}}" bindtap="onPause">
      <text>⏸</text><text>暂停</text>
    </view>
    <view class="btn accent" bindtap="onAddScore"><text>得分</text></view>
    <view class="btn accent" bindtap="onReduceScore"><text>失分</text></view>
    <view class="btn secondary" bindtap="onChangeAll"><text>全换</text></view>
    <view class="btn secondary" bindtap="onOpenBatch"><text>编辑</text></view>
    <view class="btn secondary" bindtap="onEnd"><text>查看</text></view>
    <view class="btn secondary" bindtap="onToggleTheme"><text>{{themeIcon}}</text></view>
    <view class="btn danger" bindtap="onReset"><text>重置</text></view>
    <view class="btn secondary" bindtap="onExport"><text>💾</text><text>导出</text></view>
  </view>

  <!-- ── 队员卡片 ── -->
  <view class="container">
    <view class="card {{item.selected ? 'selected' : ''}}"
          wx:for="{{cards}}" wx:key="serial"
          data-serial="{{item.serial}}" bindtap="onCardTap">
      <view class="role {{item.role === 'G' ? 'role-g' : ''}}">{{item.role}}</view>
      <view class="edit-button" data-serial="{{item.serial}}" catchtap="onOpenPlayerEdit">✏</view>
      <view class="number">{{item.number}}</view>
      <view class="timer">{{item.clock}}</view>
      <view class="score" wx:if="{{item.score}}">{{item.score}}</view>
    </view>
  </view>

  <!-- ── 结果区 ── -->
  <view class="results-container">
    <view class="goals-display" wx:if="{{goals.length > 0}}">
      <view class="section-title accent-title">进球记录</view>
      <view class="goal-entry" wx:for="{{goals}}" wx:key="id">
        <text class="goal-strong">{{item.title}}</text>
        <text> - 时间: {{item.time}} - 球员: {{item.players}} - 比分: {{item.score}}</text>
      </view>
    </view>

    <scroll-view class="table-scroll" scroll-x wx:if="{{showResults}}">
      <view class="results-table">
        <view class="tr th-row">
          <view class="th">号码</view>
          <view class="th">位置</view>
          <view class="th wide">经过时长 (分:秒)</view>
        </view>
        <view class="tr" wx:for="{{results}}" wx:key="serial">
          <view class="td">{{item.number}}</view>
          <view class="td">{{item.role}}</view>
          <view class="td wide">{{item.periodFormat}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- ── 操作说明 ── -->
  <view class="shortcut-info">
    <view class="section-title">操作快捷键</view>
    <view class="shortcut-grid">
      <view class="shortcut-item">双击<text class="shortcut-key">空格</text> 切换开始/暂停</view>
      <view class="shortcut-item"><text class="shortcut-key">←</text> 快退 (增加倒计时时间)</view>
      <view class="shortcut-item"><text class="shortcut-key">→</text> 快进 (减少倒计时时间)</view>
      <view class="shortcut-item"><text class="shortcut-key">+</text> 得分记录</view>
      <view class="shortcut-item"><text class="shortcut-key">-</text> 失分记录</view>
      <view class="shortcut-item">点击<text class="shortcut-key">编辑</text> 设置选手号码|位置</view>
      <view class="shortcut-item">点击<text class="shortcut-key">查看</text> 显示选手在场时间</view>
      <view class="shortcut-item">点击<text class="shortcut-key">重置</text> 还原计时保留号码|位置</view>
      <view class="shortcut-item">点击<text class="shortcut-key">导出</text> 下载选手在场时间数据</view>
    </view>
  </view>

  <!-- ── 设置比赛内容弹窗（原版 #myModal） ── -->
  <view class="modal" wx:if="{{setupVisible}}">
    <view class="modal-content">
      <view class="center modal-title">设置比赛内容</view>
      <view class="center">
        <view class="form-table">
          <view class="form-row">
            <view class="form-label">队员人数:</view>
            <view class="form-field">
              <input class="ipt" type="number" value="{{form.players}}" bindinput="onFormPlayers" />
            </view>
          </view>
          <view class="form-row">
            <view class="form-label">比赛时长(分钟):</view>
            <view class="form-field">
              <input class="ipt" type="number" value="{{form.minutes}}" bindinput="onFormMinutes" />
            </view>
          </view>
          <view class="form-row">
            <view class="form-label">主/客队:</view>
            <view class="form-field">
              <picker range="{{teamOptions}}" range-key="label" value="{{form.teamIndex}}" bindchange="onFormTeam">
                <view class="ipt picker">{{teamOptions[form.teamIndex].label}}</view>
              </picker>
            </view>
          </view>
        </view>
      </view>
      <view class="center">
        <view class="modal-btn" bindtap="onSetupSubmit">提交</view>
      </view>
    </view>
  </view>

  <!-- ── 批量编辑弹窗（原版 #batchModal） ── -->
  <view class="modal" wx:if="{{batchVisible}}">
    <view class="modal-content">
      <view class="close" bindtap="onCloseBatch">×</view>
      <view class="center modal-title">编辑</view>
      <scroll-view class="batch-scroll" scroll-y>
        <view class="results-table">
          <view class="tr th-row">
            <view class="th">号码</view>
            <view class="th">位置</view>
          </view>
          <view class="tr" wx:for="{{batchRows}}" wx:key="serial">
            <view class="td">
              <input class="ipt cell-ipt" type="number" value="{{item.number}}"
                     data-index="{{index}}" bindinput="onBatchNumber" />
            </view>
            <view class="td">
              <input class="ipt cell-ipt" type="text" value="{{item.role}}"
                     data-index="{{index}}" bindinput="onBatchRole" />
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="center">
        <view class="modal-btn" bindtap="onBatchSubmit">提交</view>
      </view>
    </view>
  </view>

  <!-- ── 球员信息编辑弹窗（原版 #scoreModal） ── -->
  <view class="modal" wx:if="{{scoreVisible}}">
    <view class="modal-content">
      <view class="close" bindtap="onCloseScore">×</view>
      <view class="center modal-title">{{scoreTitle}}</view>
      <view class="center score-context">
        <view class="form-row inline">
          <view class="form-label">号码:</view>
          <input class="ipt short" type="number" value="{{editNumber}}" bindinput="onEditNumber" />
          <view class="form-label">位置:</view>
          <input class="ipt short" type="text" value="{{editRole}}" bindinput="onEditRole" />
        </view>
      </view>
      <view class="center">
        <view class="modal-btn" bindtap="onScoreSubmit">提交</view>
      </view>
    </view>
  </view>

  <!-- ── Toast（原版 #tipModal） ── -->
  <view class="tip-modal {{tipShow ? 'show' : ''}}">{{tipText}}</view>
</view>
