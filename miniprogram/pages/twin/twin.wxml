<view class="wrap">
  <view class="hud">
    <view class="hud-item"><text class="hud-label">分数</text><text class="hud-val">{{score}}</text></view>
    <view class="hud-item"><text class="hud-label">难度</text><text class="hud-val">{{level}}</text></view>
    <view class="hud-item"><text class="hud-label">躲过</text><text class="hud-val">{{dodged}}</text></view>
    <view class="hud-item"><text class="hud-label">最高</text><text class="hud-val">{{best}}</text></view>
  </view>

  <view class="board"
        bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd">
    <view wx:for="{{cells}}" wx:key="id" class="cell cell-{{item.t}}"></view>
  </view>

  <view class="legend">
    <text class="dot blue"></text>你（蓝）<text class="dot green"></text>镜像（绿）<text class="dot red"></text>危险
  </view>

  <view class="overlay" wx:if="{{phase === 'ready'}}">
    <view class="ov-title">双子闪避</view>
    <view class="ov-desc">只控制蓝点，绿点永远水平镜像。危险从两侧砸来——找一条让「两个自己」都安全的走位。滑动屏幕移动。</view>
    <view class="btn" hover-class="btn-hover" bindtap="onStartTap">开始</view>
  </view>

  <view class="overlay" wx:if="{{phase === 'over'}}">
    <view class="ov-title">撞上了！</view>
    <view class="ov-score">本局 {{score}} · 最高 {{best}}</view>
    <view class="btn" hover-class="btn-hover" bindtap="restart">再来一局</view>
  </view>
</view>
