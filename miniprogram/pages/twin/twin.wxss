.wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
  background: #06080f;
}

.hud { display: flex; gap: 18rpx; margin-bottom: 18rpx; }
.hud-item {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 10rpx 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 120rpx;
}
.hud-label { font-size: 20rpx; color: rgba(255, 255, 255, 0.5); }
.hud-val { font-size: 38rpx; font-weight: 700; color: #e6edf6; }

.board {
  display: flex;
  flex-wrap: wrap;
  width: 656rpx;
  gap: 4rpx;
  background: #0b0f1a;
  padding: 8rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  touch-action: none;
}

.cell {
  width: 56rpx;
  height: 56rpx;
  border-radius: 10rpx;
  background: #141a2b;
}
.cell-blue { background: radial-gradient(circle, #3b82f6, #1d4ed8); box-shadow: 0 0 16rpx #3b82f6; }
.cell-green { background: radial-gradient(circle, #34d399, #059669); box-shadow: 0 0 16rpx #34d399; }
.cell-static { background: radial-gradient(circle, #f87171, #dc2626); box-shadow: 0 0 14rpx #ef4444; }
.cell-chaser {
  background: radial-gradient(circle, #fb923c, #ea580c);
  box-shadow: 0 0 14rpx #f97316;
  animation: pulse 0.6s infinite alternate;
}
@keyframes pulse { from { opacity: 0.65; } to { opacity: 1; } }

.legend {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  display: flex;
  align-items: center;
}
.dot { width: 18rpx; height: 18rpx; border-radius: 50%; display: inline-block; margin: 0 6rpx; }
.dot.blue { background: #3b82f6; }
.dot.green { background: #34d399; }
.dot.red { background: #ef4444; }

.overlay {
  position: fixed;
  inset: 0;
  background: rgba(6, 8, 15, 0.82);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}
.ov-title { font-size: 64rpx; font-weight: 800; color: #fff; margin-bottom: 24rpx; }
.ov-desc { font-size: 28rpx; color: rgba(255, 255, 255, 0.7); line-height: 1.6; text-align: center; margin-bottom: 48rpx; }
.ov-score { font-size: 34rpx; color: #e6edf6; margin-bottom: 40rpx; }
.btn {
  background: linear-gradient(90deg, #3b82f6, #6366f1);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  padding: 22rpx 70rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(59, 130, 246, 0.4);
}
.btn-hover { opacity: 0.85; }
