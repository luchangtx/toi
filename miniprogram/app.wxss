/* ============================================
   全局主题 - 深色科技风
   从 index.html 提取的设计令牌
   ============================================ */
page {
  --bg-base: #06080f;
  --bg-elev: rgba(255, 255, 255, 0.03);
  --border-soft: rgba(255, 255, 255, 0.06);
  --border-mid: rgba(255, 255, 255, 0.08);
  --text-main: #e0e0e0;
  --text-strong: #ffffff;
  --text-dim: rgba(255, 255, 255, 0.4);
  --text-faint: rgba(255, 255, 255, 0.2);

  --c-indigo: #818cf8;
  --c-fuchsia: #e879f9;
  --c-emerald: #34d399;
  --c-gold: #ffd700;
  --c-orange: #ff8c00;
  --c-blue: #60a5fa;

  background: var(--bg-base);
  color: var(--text-main);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

view, text, button, input, scroll-view {
  box-sizing: border-box;
}

/* 去掉 button 默认样式 */
button {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: normal;
  font-size: inherit;
  color: inherit;
}
button::after {
  border: none;
}

/* ============ 通用工具类 ============ */
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.hidden {
  display: none;
}

/* 通用返回按钮（自定义导航页面使用） */
.nav-back {
  position: fixed;
  left: 24rpx;
  z-index: 999;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 34rpx;
}
.nav-back:active {
  background: rgba(0, 0, 0, 0.7);
}
